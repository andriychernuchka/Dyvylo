{
  "name": "dyvylo-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "DYVYLO - Media Hub",
  "scripts": {
    "prepare": "husky",
    "dev": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "preview": "npm run preview --prefix client",
    "lint": "npm run lint --prefix client",
    "format": "npm run format --prefix client",
    "format:check": "npm run format:check --prefix client",
    "test:component": "npm run test:component --prefix client",
    "test:e2e": "npm run test:e2e --prefix client",
    "test": "npm run test --prefix client"
  },
  "lint-staged": {
    "client/**/*.{js,jsx}": [
      "npm run lint --prefix client",
      "npm run format:check --prefix client"
    ],
    "client/**/*.{json,html,md}": [
      "npm run format:check --prefix client"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  }
}
